@page "/settings"
@inject FlatApp.Mobile.Services.Auth.IAuthService AuthService
@inject FlatApp.Mobile.Services.Flats.IFlatService FlatService
@inject NavigationManager Navigation

<section class="placeholder-card settings-page">
    <p class="status-label">Settings</p>

    @if (isLoading)
    {
        <h1>Loading settings...</h1>
        <p>Checking your account and current flat.</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <h1>Login required</h1>
        <p>@errorMessage</p>

        <div class="hero-actions">
            <a class="primary-button" href="login">Log in</a>
            <a class="secondary-button" href="register">Create account</a>
        </div>
    }
    else
    {
        <h1>Settings</h1>
        <p>Manage your profile, current flat, privacy controls, and mobile session.</p>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="settings-profile-card">
            <div class="settings-avatar" aria-hidden="true">@Initial(userName)</div>
            <div>
                <p class="status-label">Account</p>
                <h2>@(userName ?? "Unknown user")</h2>
                <p>@(userEmail ?? "Not available")</p>
            </div>
            <span>Connected</span>
        </div>

        <div class="settings-stack settings-card-stack">
            <div class="settings-row settings-card-row">
                <div>
                    <strong>My profile</strong>
                    <small>Phone, bank account, and home details</small>
                </div>
                <a class="settings-link" href="profile">Edit</a>
            </div>

            <div class="settings-row settings-card-row">
                <div>
                    <strong>Current flat</strong>
                    <small>@(currentFlatName ?? "Create or join a flat to get started")</small>
                </div>
                <a class="settings-link" href="flat-onboarding">Manage</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(inviteCode))
            {
                <div class="settings-row settings-card-row invite-code-row">
                    <div>
                        <strong>Invite code</strong>
                        <small>@inviteCode</small>
                    </div>
                    <button type="button" class="settings-link" @onclick="CopyInviteCodeAsync">
                        Copy
                    </button>
                </div>
            }

            <div class="settings-row settings-card-row">
                <div>
                    <strong>Mobile app</strong>
                    <small>Connected to your FlatNZ account</small>
                </div>
                <span class="settings-pill">Active</span>
            </div>

            <div class="settings-row settings-card-row">
                <div>
                    <strong>Privacy policy</strong>
                    <small>Review how FlatNZ Mobile handles account, flat, finance, and receipt data</small>
                </div>
                <a class="settings-link" href="privacy-policy">View</a>
            </div>

            <div class="settings-row settings-card-row">
                <div>
                    <strong>Delete account and data</strong>
                    <small>Open the in-app deletion path and current support process</small>
                </div>
                <a class="settings-link" href="account-deletion">Review</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(inviteCode))
        {
            <div class="status-card compact-status management-hub-card">
                <p class="status-label">Flat management hub</p>
                <h2>People, requests, and activity</h2>
                <p>Use these shortcuts to manage active flatmates, review access requests, and audit recent updates.</p>
                <div class="management-shortcuts">
                    <a href="members"><span>👥</span><strong>Members</strong><small>Review roles</small></a>
                    <a href="join-requests"><span>+</span><strong>Join requests</strong><small>Approve access</small></a>
                    <a href="activity"><span>↻</span><strong>Activity</strong><small>Audit updates</small></a>
                </div>
            </div>

            <div class="status-card compact-status invite-card">
                <p class="status-label">Invite flatmates</p>
                <h2>@inviteCode</h2>
                <p>Share this code with someone who wants to request access to your flat. Then review pending requests from this app.</p>
                <div class="hero-actions">
                    <button type="button" class="primary-button" @onclick="CopyInviteCodeAsync">Copy invite code</button>
                    <a class="secondary-button" href="join-requests">Manage requests</a>
                </div>
            </div>
        }

        <div class="status-card compact-status compliance-card">
            <p class="status-label">Play Store readiness</p>
            <h2>Privacy and account controls</h2>
            <p>FlatNZ Mobile now exposes an in-app privacy policy and an in-app account deletion path. Use the support email below for privacy questions or deletion requests while the self-service backend flow is being prepared.</p>
            <div class="hero-actions">
                <a class="secondary-button" href="privacy-policy">Open privacy policy</a>
                <a class="secondary-button" href="account-deletion">Open deletion page</a>
                <button type="button" class="secondary-button" @onclick="CopySupportEmailAsync">Copy support email</button>
            </div>
        </div>

        <button type="button" class="secondary-button full-width settings-logout" @onclick="ShowLogoutConfirm" disabled="@isLoggingOut">
            @(isLoggingOut ? "Logging out..." : "Log out")
        </button>
    }
</section>

<ConfirmDialog IsOpen="showLogoutConfirm"
               IsBusy="isLoggingOut"
               IsDanger="true"
               Eyebrow="Log out"
               Title="Log out of FlatNZ?"
               Message="You will need to log in again before managing your flat on this device."
               ConfirmText="Log out"
               BusyText="Logging out..."
               OnConfirm="LogoutAsync"
               OnCancel="HideLogoutConfirm" />

<style>
    .settings-page {
        padding-bottom: 7rem;
    }

    .settings-profile-card {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: .9rem;
        align-items: center;
        margin-top: 1rem;
        padding: 1rem;
        border: 1px solid color-mix(in srgb, var(--flat-primary) 35%, var(--flat-border));
        border-radius: 1.35rem;
        background: color-mix(in srgb, var(--flat-primary) 7%, var(--flat-card));
    }

    .settings-avatar {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border-radius: 999px;
        color: var(--flat-primary);
        border: 1px solid color-mix(in srgb, var(--flat-primary) 45%, var(--flat-border));
        background: color-mix(in srgb, var(--flat-primary) 8%, transparent);
        font-weight: 950;
    }

    .settings-profile-card h2,
    .settings-profile-card p {
        margin: 0;
    }

    .settings-profile-card h2 {
        color: var(--flat-text);
        font-size: 1.25rem;
    }

    .settings-profile-card p:last-child {
        color: var(--flat-muted);
    }

    .settings-profile-card > span {
        padding: .3rem .65rem;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--flat-primary) 45%, var(--flat-border));
        color: var(--flat-primary);
        font-size: .72rem;
        font-weight: 900;
    }

    .settings-card-stack {
        margin-top: 1rem;
    }

    .settings-card-row {
        border: 1px solid var(--flat-border);
        border-radius: 1rem;
        background: color-mix(in srgb, var(--flat-card) 92%, transparent);
    }

    .invite-code-row small {
        color: var(--flat-primary);
        font-weight: 900;
        letter-spacing: .08em;
    }

    .management-hub-card,
    .invite-card,
    .compliance-card {
        margin-top: 1rem;
    }

    .management-shortcuts {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .65rem;
        margin-top: 1rem;
    }

    .management-shortcuts a {
        display: grid;
        gap: .25rem;
        padding: .85rem;
        border-radius: 1rem;
        border: 1px solid var(--flat-border);
        background: rgba(11, 17, 28, .56);
        color: var(--flat-text);
        text-decoration: none;
    }

    .management-shortcuts span {
        color: var(--flat-primary);
        font-weight: 950;
    }

    .management-shortcuts strong {
        font-size: .9rem;
        line-height: 1.2;
    }

    .management-shortcuts small {
        color: var(--flat-muted);
        font-size: .75rem;
    }

    .invite-card h2 {
        color: var(--flat-primary);
        letter-spacing: .12em;
    }

    @@media (max-width: 430px) {
        .settings-profile-card {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .settings-profile-card > span {
            grid-column: 1 / -1;
            justify-self: start;
        }

        .management-shortcuts {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private const string SupportEmail = "support@yobany.top";

    private bool isLoading = true;
    private bool isLoggingOut;
    private bool showLogoutConfirm;
    private string? errorMessage;
    private string? successMessage;
    private string? userName;
    private string? userEmail;
    private string? currentFlatName;
    private string? inviteCode;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var meTask = AuthService.GetMeAsync();
            var currentFlatTask = FlatService.GetCurrentAsync();
            var inviteCodeTask = FlatService.GetCurrentInviteCodeAsync();

            await Task.WhenAll(meTask, currentFlatTask, inviteCodeTask);

            var me = meTask.Result;
            userName = me?.User.Name;
            userEmail = me?.User.Email;

            var currentFlat = currentFlatTask.Result;
            currentFlatName = currentFlat?.CurrentFlat?.Name;
            inviteCode = inviteCodeTask.Result;
        }
        catch (FlatApp.Mobile.Services.Api.ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("login", replace: true);
        }
        catch (Exception)
        {
            errorMessage = "Unable to load settings. Please check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CopyInviteCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(inviteCode))
        {
            return;
        }

        try
        {
            await Clipboard.Default.SetTextAsync(inviteCode);
            successMessage = "Invite code copied.";
        }
        catch (Exception)
        {
            errorMessage = "Unable to copy the invite code on this device.";
        }
    }

    private async Task CopySupportEmailAsync()
    {
        try
        {
            await Clipboard.Default.SetTextAsync(SupportEmail);
            successMessage = "Support email copied.";
        }
        catch (Exception)
        {
            errorMessage = "Unable to copy the support email on this device.";
        }
    }

    private void ShowLogoutConfirm()
    {
        showLogoutConfirm = true;
    }

    private void HideLogoutConfirm()
    {
        showLogoutConfirm = false;
    }

    private async Task LogoutAsync()
    {
        isLoggingOut = true;

        try
        {
            await AuthService.LogoutAsync();
        }
        catch (Exception)
        {
        }
        finally
        {
            isLoggingOut = false;
            showLogoutConfirm = false;
            Navigation.NavigateTo("login", replace: true);
        }
    }

    private static string Initial(string? name)
    {
        return string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
    }
}
