@using FlatApp.Mobile.Models.Finance

@if (Finance is not null)
{
    <div class="finance-dashboard-panel">
        <div class="finance-metric-grid">
            <article class="finance-metric-card"><p>Total</p><strong>@Money(Finance.Summary.TotalExpenses)</strong></article>
            <article class="finance-metric-card"><p>Transactions</p><strong>@Finance.Summary.Transactions</strong></article>
            <article class="finance-metric-card"><p>Avg/User</p><strong>@Money(Finance.Summary.AvgPerUser)</strong></article>
            <article class="finance-metric-card"><p>Top spender</p><strong>@(Finance.Summary.TopSpender?.Name ?? "—")</strong></article>
        </div>

        <section class="finance-balance-summary">
            <div><p>You owe</p><strong class="finance-negative">@Money(Finance.Summary.YouOwe)</strong></div>
            <div><p>You are owed</p><strong class="finance-positive">@Money(Finance.Summary.YouAreOwed)</strong></div>
            <div><p>Net</p><strong class="@AmountClass(Finance.Summary.NetBalance)">@Money(Finance.Summary.NetBalance)</strong></div>
        </section>

        <section class="finance-chart-card">
            <h2>Spending by user</h2>
            @if (UserRows.Count == 0)
            {
                <p class="finance-empty-text">No spending data yet.</p>
            }
            else
            {
                <div class="finance-chart-list">
                    @foreach (var row in UserRows)
                    {
                        <div class="finance-bar-row">
                            <div><span>@row.Label</span><strong>@Money(row.Amount)</strong></div>
                            <div class="finance-bar-track"><span style="width: @row.Percentage%"></span></div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="finance-chart-card">
            <h2>Balance distribution</h2>
            @if (BalanceRows.Count == 0)
            {
                <p class="finance-empty-text">No balance data yet.</p>
            }
            else
            {
                <div class="finance-chart-list">
                    @foreach (var row in BalanceRows)
                    {
                        <div class="finance-bar-row">
                            <div><span>@row.Label</span><strong class="@AmountClass(row.Amount)">@Money(row.Amount)</strong></div>
                            <div class="finance-bar-track"><span class="@(row.Amount >= 0 ? "positive" : "negative")" style="width: @row.Percentage%"></span></div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="finance-chart-card">
            <h2>Spending by category</h2>
            @if (CategoryRows.Count == 0)
            {
                <p class="finance-empty-text">No category data yet.</p>
            }
            else
            {
                <div class="finance-category-layout">
                    <div class="finance-pie-chart" style="background: conic-gradient(@PieSegments);"></div>
                    <div class="finance-legend-list">
                        @foreach (var row in CategoryRows)
                        {
                            <div><span class="finance-dot" style="background: @row.Color"></span><span>@row.Label</span><strong>@Money(row.Amount)</strong></div>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="finance-chart-card">
            <h2>Balances</h2>
            @if (Finance.Balances.Count == 0)
            {
                <p class="finance-empty-text">No balances yet.</p>
            }
            else
            {
                <div class="finance-simple-list">
                    @foreach (var balance in Finance.Balances)
                    {
                        <div><span>@balance.User.Name</span><strong class="@AmountClass(balance.Balance)">@Money(balance.Balance)</strong></div>
                    }
                </div>
            }
        </section>

        <section class="finance-chart-card">
            <h2>Who should pay who</h2>
            @if (Finance.OptimizedPayments.Count == 0)
            {
                <p class="finance-empty-text">No suggested payments right now.</p>
            }
            else
            {
                <div class="finance-simple-list">
                    @foreach (var payment in Finance.OptimizedPayments)
                    {
                        <div><span>@payment.From.Name → @payment.To.Name</span><strong>@Money(payment.Amount)</strong></div>
                    }
                </div>
            }
        </section>
    </div>
}

<style>
    .finance-dashboard-panel {
        display: grid;
        gap: 1rem;
        margin-top: 1rem;
    }

    .finance-metric-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
    }

    .finance-metric-card,
    .finance-balance-summary,
    .finance-chart-card {
        border: 1px solid var(--flat-border);
        border-radius: 1.15rem;
        background: color-mix(in srgb, var(--flat-card) 92%, transparent);
    }

    .finance-metric-card {
        display: grid;
        gap: .3rem;
        min-height: 5.6rem;
        padding: .9rem;
    }

    .finance-metric-card p,
    .finance-balance-summary p,
    .finance-empty-text {
        margin: 0;
        color: var(--flat-muted);
        font-size: .82rem;
        font-weight: 800;
    }

    .finance-metric-card strong,
    .finance-balance-summary strong {
        color: var(--flat-text);
        font-size: 1.15rem;
        line-height: 1.2;
    }

    .finance-balance-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .65rem;
        padding: .9rem;
    }

    .finance-balance-summary div {
        display: grid;
        gap: .25rem;
    }

    .finance-chart-card {
        display: grid;
        gap: .85rem;
        padding: 1rem;
    }

    .finance-chart-card h2 {
        margin: 0;
        color: var(--flat-text);
        font-size: 1.05rem;
    }

    .finance-chart-list,
    .finance-simple-list,
    .finance-legend-list {
        display: grid;
        gap: .75rem;
    }

    .finance-bar-row {
        display: grid;
        gap: .35rem;
    }

    .finance-bar-row > div:first-child,
    .finance-simple-list > div,
    .finance-legend-list > div {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

    .finance-bar-row span,
    .finance-simple-list span,
    .finance-legend-list span {
        color: var(--flat-muted);
        font-size: .88rem;
    }

    .finance-bar-row strong,
    .finance-simple-list strong,
    .finance-legend-list strong {
        color: var(--flat-text);
        font-size: .9rem;
        white-space: nowrap;
    }

    .finance-bar-track {
        height: .55rem;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(148, 163, 184, .16);
    }

    .finance-bar-track span {
        display: block;
        min-width: .35rem;
        height: 100%;
        border-radius: inherit;
        background: var(--flat-primary);
    }

    .finance-bar-track span.positive {
        background: var(--flat-success);
    }

    .finance-bar-track span.negative {
        background: #f87171;
    }

    .finance-category-layout {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 1rem;
        align-items: center;
    }

    .finance-pie-chart {
        width: 6.5rem;
        height: 6.5rem;
        border-radius: 999px;
        border: .6rem solid rgba(11, 17, 28, .86);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
    }

    .finance-dot {
        display: inline-block;
        width: .7rem;
        height: .7rem;
        border-radius: 999px;
        margin-right: .45rem;
    }

    .finance-positive {
        color: var(--flat-success) !important;
    }

    .finance-negative {
        color: #f87171 !important;
    }

    .finance-neutral {
        color: var(--flat-muted) !important;
    }

    @@media (max-width: 430px) {
        .finance-balance-summary,
        .finance-category-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [Parameter]
    public FinanceResponse? Finance { get; set; }

    private static readonly string[] Colors = ["#00D4FF", "#A855F7", "#22C55E", "#F97316", "#EF4444", "#38BDF8"];

    private IReadOnlyList<ChartRow> UserRows
    {
        get
        {
            if (Finance is null || Finance.Expenses.Count == 0) return [];
            var totals = Finance.Expenses.GroupBy(expense => string.IsNullOrWhiteSpace(expense.PayerName) ? "Unknown" : expense.PayerName!).Select(group => new { Label = group.Key, Amount = group.Sum(expense => expense.Amount) }).OrderByDescending(row => row.Amount).ToList();
            var max = totals.Max(row => row.Amount);
            return totals.Select((row, index) => new ChartRow(row.Label, row.Amount, Percent(row.Amount, max), Colors[index % Colors.Length])).ToList();
        }
    }

    private IReadOnlyList<ChartRow> BalanceRows
    {
        get
        {
            if (Finance is null || Finance.Balances.Count == 0) return [];
            var max = Finance.Balances.Max(row => Math.Abs(row.Balance));
            return Finance.Balances.Select((row, index) => new ChartRow(row.User.Name, row.Balance, Percent(Math.Abs(row.Balance), max), Colors[index % Colors.Length])).ToList();
        }
    }

    private IReadOnlyList<ChartRow> CategoryRows
    {
        get
        {
            if (Finance is null || Finance.Categories.Count == 0) return [];
            var rows = Finance.Categories.Where(row => row.Amount > 0).OrderByDescending(row => row.Amount).ToList();
            var total = rows.Sum(row => row.Amount);
            return rows.Select((row, index) => new ChartRow(CategoryLabel(row.Category), row.Amount, Percent(row.Amount, total), Colors[index % Colors.Length])).ToList();
        }
    }

    private string PieSegments
    {
        get
        {
            if (CategoryRows.Count == 0) return "rgba(148,163,184,.18) 0% 100%";
            decimal start = 0;
            var segments = new List<string>();
            foreach (var row in CategoryRows)
            {
                var end = start + row.Percentage;
                segments.Add($"{row.Color} {start:0.##}% {end:0.##}%");
                start = end;
            }
            return string.Join(", ", segments);
        }
    }

    private static decimal Percent(decimal value, decimal max) => max <= 0 ? 0 : Math.Round(Math.Max(4m, Math.Min(100m, value / max * 100m)), 2);
    private static string Money(decimal amount) => $"${amount:0.00}";
    private static string AmountClass(decimal amount) => amount < 0 ? "finance-negative" : amount > 0 ? "finance-positive" : "finance-neutral";
    private static string CategoryLabel(string category) => string.IsNullOrWhiteSpace(category) ? "Other" : System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(category.Replace("_", " ").ToLowerInvariant());

    private sealed record ChartRow(string Label, decimal Amount, decimal Percentage, string Color);
}
