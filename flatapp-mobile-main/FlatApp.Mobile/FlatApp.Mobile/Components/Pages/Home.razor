@page "/"
@inject FlatApp.Mobile.Services.Auth.IAuthService AuthService
@inject NavigationManager Navigation

<section class="hero-card">
    <div class="eyebrow">Flatmate living, simplified</div>
    <h1>FlatNZ</h1>
    <p>
        Manage chores, shopping, shared expenses, payments, and flat settings from one mobile-first app.
    </p>

    <div class="hero-actions">
        <a class="primary-button" href="login">Sign in</a>
        <a class="secondary-button" href="register">Create account</a>
    </div>
</section>

<section class="status-card">
    <div>
        <p class="status-label">Mobile companion app</p>
        <h2>Designed for flatmates</h2>
        <p>Sign in first to access your flat dashboard, chores, shopping, finance, and settings.</p>
    </div>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("dashboard", replace: true);
        }
    }
}
